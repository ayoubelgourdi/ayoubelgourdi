<svg width="900" height="260" viewBox="0 0 900 260" xmlns="http://www.w3.org/2000/svg" font-family="Consolas, 'Courier New', monospace">
  <defs>
    <linearGradient id="winGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1e1e2e"/>
      <stop offset="100%" stop-color="#11111b"/>
    </linearGradient>
    <clipPath id="roundedWin">
      <rect x="0" y="0" width="900" height="260" rx="14" ry="14"/>
    </clipPath>
  </defs>

  <g clip-path="url(#roundedWin)">
    <rect x="0" y="0" width="900" height="260" fill="url(#winGrad)"/>

    <!-- Title bar -->
    <rect x="0" y="0" width="900" height="36" fill="#191927"/>
    <circle cx="22" cy="18" r="7" fill="#ff5f56"/>
    <circle cx="46" cy="18" r="7" fill="#ffbd2e"/>
    <circle cx="70" cy="18" r="7" fill="#27c93f"/>
    <text x="450" y="23" fill="#8b8ba7" font-size="13" text-anchor="middle">ayoub@agadir: ~</text>

    <!-- Terminal body -->
    <text x="24" y="70" font-size="16" fill="#27c93f">
      ayoub@agadir
      <tspan fill="#8b8ba7">:</tspan><tspan fill="#5aa2ff">~</tspan><tspan fill="#8b8ba7">$</tspan>
      <tspan fill="#f5f5f5"> whoami</tspan>
    </text>

    <text x="24" y="100" font-size="16" fill="#00ff9c" font-weight="bold">
      Ayoub Elgourdi
      <animate attributeName="opacity" values="0;0;1" keyTimes="0;0.35;0.4" dur="6s" begin="0s" fill="freeze"/>
    </text>

    <text x="24" y="132" font-size="16" fill="#27c93f">
      ayoub@agadir
      <tspan fill="#8b8ba7">:</tspan><tspan fill="#5aa2ff">~</tspan><tspan fill="#8b8ba7">$</tspan>
      <tspan fill="#f5f5f5"> cat role.txt</tspan>
      <animate attributeName="opacity" values="0;0;1" keyTimes="0;0.42;0.46" dur="6s" fill="freeze"/>
    </text>

    <text x="24" y="162" font-size="16" fill="#f5f5f5">
      Web Developer — Learning &amp; Building
      <animate attributeName="opacity" values="0;0;1" keyTimes="0;0.55;0.6" dur="6s" fill="freeze"/>
    </text>

    <text x="24" y="194" font-size="16" fill="#27c93f">
      ayoub@agadir
      <tspan fill="#8b8ba7">:</tspan><tspan fill="#5aa2ff">~</tspan><tspan fill="#8b8ba7">$</tspan>
      <tspan fill="#f5f5f5"> echo $LOCATION</tspan>
      <animate attributeName="opacity" values="0;0;1" keyTimes="0;0.65;0.7" dur="6s" fill="freeze"/>
    </text>

    <text x="24" y="224" font-size="16" fill="#ffbd2e">
      Agadir, Morocco 🇲🇦
      <animate attributeName="opacity" values="0;0;1" keyTimes="0;0.78;0.82" dur="6s" fill="freeze"/>
    </text>

    <!-- Blinking cursor -->
    <rect x="24" y="234" width="10" height="16" fill="#00ff9c">
      <animate attributeName="opacity" values="0;0;1;1;0" keyTimes="0;0.9;0.91;0.98;1" dur="6s" repeatCount="indefinite"/>
    </rect>
  </g>

  <rect x="1" y="1" width="898" height="258" rx="14" ry="14" fill="none" stroke="#2a2a3d" stroke-width="1.5"/>
</svg>
